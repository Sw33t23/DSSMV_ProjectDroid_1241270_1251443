@startuml
'https://plantuml.com/use-case-diagram
skinparam classAttributeIconSize 0

class User {
    - id:int
    - name : String
    - email : String
    - password: String
    - totalPoints: int
    --
    + login(): boolean
    + registerRecycling(record: RecyclingRecord): void
    + updatePoints(points: int): void
}
class RecycleRecord {
  -id: int
  - sacksYellow: int
  - sacksBlue: int
  - sacksGreen: int
  - pointsEarned: int
  - createdAt: String
  --
  + calculatePoints(): int
}
class EcoPoint {
  - id: int
  - name: String
  - latitude: double
  - longitude: double
    --
  + getCoordinates(): String
}
User "1" --> "*" RecycleRecord : registers >
