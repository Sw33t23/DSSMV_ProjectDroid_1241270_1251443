@startuml
'https://plantuml.com/sequence-diagram

hide empty members
skinparam classAttributeIconSize 0

class "User" {
    id: int
    name: String
    email: String
    ecologicalPoints: int
}


class "RecycleRecord" {
    id: int
    sacksYellow: int
    sacksBlue: int
    sacksGreen: int
    pointsEarned: int
    createdAt: String
}

class "EcoPoint" {
    id: int
    name: String
    latitude: double
    longitude: double
}


User "1" --> "*" RecycleRecord : Registers >
RecycleRecord "*" --> "1" EcoPoint : Located at >

@enduml