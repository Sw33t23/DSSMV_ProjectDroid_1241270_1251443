<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F9FA"
        tools:context=".MainActivity">

    <!-- Grupo Centralizado Verticalmente -->
    <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱 Olá, Utilizador!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/cardPoints"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

    <!-- Cartão de Pontos Moderno -->
    <androidx.cardview.widget.CardView
            android:id="@+id/cardPoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintBottom_toTopOf="@id/cardBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Os Teus Pontos"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#6C757D" />

            <TextView
                    android:id="@+id/tvUserPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pts"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#2ECC71"
                    android:layout_marginTop="6dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Cartão de Medalha e Barra de Progresso Moderna -->
    <androidx.cardview.widget.CardView
            android:id="@+id/cardBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/cardPoints"
            app:layout_constraintBottom_toTopOf="@id/btnLeaderboard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medalha Atual"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#6C757D"
                    android:layout_gravity="center" />

            <TextView
                    android:id="@+id/tvUserBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Eco-Iniciante"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E67E22"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="center" />

            <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Progresso para o Nível 2: 0/50 pts"
                    android:textSize="12sp"
                    android:textColor="#adb5bd"
                    android:layout_marginTop="16dp" />

            <ProgressBar
                    android:id="@+id/progressBarBadge"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/custom_progress"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botão Leaderboard -->
    <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:text="🏆 Ver Leaderboard Global"
            android:backgroundTint="#2ECC71"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardBadge"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/black"
            app:itemTextColor="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>