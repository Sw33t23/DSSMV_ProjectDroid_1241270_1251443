<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FA"
        android:padding="24dp"
        android:gravity="center_horizontal">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♻️ Registar Reciclagem"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:layout_marginBottom="32dp" />

    <!-- Campo Saca Amarela -->
    <EditText
            android:id="@+id/etYellowSacks"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Sacas Amarelas (Plástico/Metal)"
            android:inputType="number"
            android:background="@drawable/card_background"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:layout_marginBottom="16dp" />

    <!-- Campo Saca Verde -->
    <EditText
            android:id="@+id/etGreenSacks"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Sacas Verdes (Vidro)"
            android:inputType="number"
            android:background="@drawable/card_background"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:layout_marginBottom="16dp" />

    <!-- Campo Saca Azul -->
    <EditText
            android:id="@+id/etBlueSacks"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Sacas Azuis (Papel/Cartão)"
            android:inputType="number"
            android:background="@drawable/card_background"
            android:paddingHorizontal="16dp"
            android:textSize="15sp"
            android:textColor="#212529"
            android:layout_marginBottom="28dp" />

    <!-- Botão Submeter -->
    <Button
            android:id="@+id/btnSubmitRecycle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Submeter e Ganhar Pontos"
            android:backgroundTint="#2ECC71"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

</LinearLayout>